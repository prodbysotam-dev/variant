    { "knob:Flanger>Stéréo", { "Stereo", "stereo", "offsets left and right for a wider flanger." } },
    { "knob:Flanger>Through-zero", { "Through-zero", "through zero tz", "goes through zero: the sweep crosses the direct sound, a deeper effect." } },
    { "knob:Phaser>Étages", { "Stages", "stages", "the number of stages (2 to 12): more = more notches, a stronger sound." } },
