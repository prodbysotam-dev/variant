    { "knob:Phaser>Stéréo", { "Stereo", "stereo", "offsets left and right for a wider phaser." } },
    { "knob:Trémolo>Vitesse", { "Speed", "speed rate", "the speed of the pulse." } },
    { "knob:Trémolo>Profondeur", { "Depth", "depth", "how much the volume drops on each pulse." } },
    { "knob:Trémolo>Forme", { "Shape", "shape", "the shape of the pulse (smooth or choppy)." } },
    { "knob:Trémolo>Auto-pan", { "Auto-pan", "auto pan autopan", "pulses left / right instead of the volume." } },
