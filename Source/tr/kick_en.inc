    { "charger un son|importer un sample|ajouter un son|mettre un son|glisser un son|mettre un son dans le plugin", { "load a sound import sample add sound drop sound put sound file browse", "Drop a sound (wav, mp3, aiff, flac…) on the big area of the Sound tab, or click it to browse. You can also pick from the Sound bank (button at the top): click = listen, double-click = load.", "" } },
    { "banque de sons|bibliotheque de sons|bibliotheque|banque", { "sound bank sound library library bank presets categories", "The Sound bank (button at the top) holds all your sounds sorted by category, plus your presets. Click a sound = listen, double-click = load it into the chosen layer. It remembers the last category you opened.", "" } },
    { "instruments de la banque|saxophone|rhodes|piano|guitare|trompette|violon|cordes", { "bank instruments saxophone sax rhodes piano guitar trumpet violin strings", "The Sound bank has Rhodes, pianos, saxes, trumpets, trombone, strings, guitars, leads, plucks, basses, 808s and sequencer sounds. Click « Sound bank » and browse the categories.", "" } },
    { "fleches de la banque|changer de son avec les fleches|son suivant|son precedent", { "bank arrows next sound previous sound up down keys browse", "Click a sound in the bank, then use the up / down arrows: FL stopped = just a preview, FL playing = the sound is swapped right away. The arrows stay in the sound list (they don't change category). With Ctrl, Shift or Alt, the arrows are left to FL.", "" } },
    { "dossier de la bibliotheque|ou sont mes sons|ajouter mes propres sons", { "library folder where are my sounds add my own sounds own folder", "Your sounds are in Documents\\Variant Bibliothèque. Add your own folders in there: they show up as categories in the Sound bank.", "" } },
    { "noms des fichiers|renommage|format des noms", { "file names renaming name format", "Library sounds are named « N Type ( Source ) »: the source in brackets is the plugin, the pack or the @creator. Variant also finds old names on its own.", "" } },
    { "son au lancement|son par defaut|son charge au demarrage", { "startup sound default sound sound loaded at launch", "Settings (gear) → « A sound loaded at launch ». To pick which one: right-click a sound in the bank.", "" } },
    { "visite guidee|tutoriel|comment ca marche|par ou commencer|debutant|comment marche le plugin|fonctionnement du plugin", { "guided tour tutorial how does it work where to start beginner how to use the plugin", "I can give you the tour: Settings (gear) → Guided tour, or type « tour » here. Otherwise hover over any button and wait a second: I'll explain what it is.", "" } },
    { "barre d'aide|aide en haut|texte d'aide", { "help bar help text hint bar tooltip", "The help bar under the tabs explains the setting under your mouse, like in FL Studio. And if you stay on a button a bit, I come and explain it myself.", "" } },
    { "onglets|pages du plugin|les pages", { "tabs plugin pages pages", "There are 6 tabs: Sound (your sample layers), Effects (the effect chain), Chords & MIDI (generator and piano roll), Arpeggio, Sampler (chopping) and Synth (a wavetable synth).", "" } },
    { "couches|layers|superposer des sons|empiler des sons", { "layers layer stack sounds layering", "You have 8 layers: one sound per layer, played together. Click a layer at the top of the Sound tab to tweak it, and turn it on/off with the round button.", "" } },
    { "couche active|allumer une couche|eteindre une couche|muter une couche", { "active layer turn on layer turn off layer mute layer", "Each layer's round button turns it on or off, without losing its sound or settings.", "" } },
    { "metamorphose|destroy|transformer le one shot|transformer le son|changer le son en autre chose|deformer le son", { "metamorphosis metamorphose destroy transform one shot transform sound mangle", "« ✦ Métamorphose ▾ » button under the waveform (Sound tab): turns the chosen layer's one-shot into another sound (pad, crystal, low, reverse swell, pluck, soft grains, wide chorus, resonator, soft tape). Light keeps the character, Total makes it unrecognisable. Every click gives a different result, always from the original, and « Back to the original sound » undoes it. The sounds made are stored in the Métamorphoses folder of your bank.", "" } },
    { "layers auto|bouton auto|completer le son|sons complementaires", { "auto layers auto button complete sound complementary sounds", "« Auto ▾ » button in the Sound tab: pick 2, 3 or 4 sounds and Variant adds complementary sounds from your library (body, low end, brightness), tuned and balanced. It also offers auto settings (note, volumes).", "" } },
    { "clic droit sur une couche|remplacer un son|retirer un son|supprimer un son|copier une couche", { "right click layer replace sound remove sound delete sound copy layer", "Right-click a layer or the waveform: replace, remove, copy to another layer, auto settings, undo.", "" } },
    { "repartition des couches|melange des couches|mode des couches", { "layer distribution layer mix layer mode", "« Layer distribution »: Stacked (all together), One note = one layer (for chords/arpeggios), Alternating, By register (low → high) or Random.", "" } },
    { "ordre des couches", { "layer order", "« Layer order »: Low → high or High → low. It decides which layer takes the low notes when the layers share the notes.", "" } },
    { "naturel entre couches|naturel", { "natural between layers natural", "« Natural »: small timing, tuning and volume offsets between layers on every note. It avoids the robotic copy-paste effect.", "" } },
    { "boucles en accord", { "loops in chords chord loops", "« Loops in chords »: when you play a chord on a loop, Lowest note = only one loop plays (no mess), All notes = every note plays the loop.", "" } },
    { "variations|round robin|variations a chaque note", { "variations round robin variation every note", "On every note, Variant plays a slightly different variant of the sound (attack, tone, length), like a real musician. Set it in the « Variations on every note » card of the Sound tab.", "" } },
    { "activer les variations|variations activees", { "enable variations variations on", "« On » (Variations card): every note plays a different variant of the sound. Off = the exact same sound every time.", "" } },
    { "style de variation", { "variation style", "« Variation style »: Realistic (like a real instrument), Texture (the tone moves more) or Experimental (it goes far).", "" } },
    { "intensite des variations|intensite", { "variation amount intensity", "« Amount »: how far the variants move away from the original sound. Low = subtle, high = every note clearly changes.", "" } },
    { "nombre de variantes|variantes", { "number of variants variants", "« Variants »: how many different takes are pre-computed (2 to 16, 8 to 16 recommended).", "" } },
    { "nouvelles variations", { "new variations regenerate", "« New variations » recomputes a new set of variants from the same sounds.", "" } },
    { "enveloppe|adsr|enveloppe du son", { "envelope adsr sound envelope", "The envelope (Sound tab) sets how the sound starts and stops: Delay, Attack, Hold, Decay, Sustain, Release. You can also drag the points of the drawing, and the small circles to curve it.", "" } },
    { "attaque|attaque du son|attack", { "attack sound attack", "« Attack »: how long the sound takes to rise at the start of the note. Short = it hits right away, long = the sound fades in gently.", "" } },
    { "declin|decay", { "decay", "« Decay »: time to fall from the peak down to the Sustain level.", "" } },
    { "maintien|sustain|niveau de maintien", { "sustain sustain level", "« Sustain »: the level held while the key is down. At 0, the sound dies on its own after the Decay even if you hold the note.", "" } },
    { "relache|release|relachement", { "release", "« Release »: fade-out time when you let go of the key. Short = dry, long = the sound lingers.", "" } },
    { "delai de l'enveloppe|delai avant le son", { "envelope delay delay before sound", "« Delay » (envelope): wait before the sound starts.", "" } },
    { "tenue|hold", { "hold", "« Hold »: time spent at the peak before the Decay starts.", "" } },
    { "courbe de l'enveloppe|courbe attaque|courbe declin|courbe relache", { "envelope curve attack curve decay curve release curve", "The envelope curves are set with the small circles on the drawing: drag them to bend each segment. Double-click a circle = straight curve.", "" } },
    { "jouer en entier|one shot jusqu'au bout|le son se coupe", { "play whole play to the end one shot sound cuts off", "« Play to the end »: on, the sound goes all the way even if you release the note. Handy for kicks, 808s and one-shots.", "" } },
    { "velocite|velocity|force de frappe", { "velocity hit strength", "« Velocity » (Sound tab): how much playing strength changes the volume. At 0, every note has the same volume.", "" } },
    { "velocite vers timbre|vel timbre", { "velocity to tone vel tone", "« Vel. → tone »: notes played softly get darker and softer in attack, not just quieter. More realistic.", "" } },
    { "volume d'une couche|volume de la couche", { "layer volume", "Each layer's Volume is in its card (Sound tab). The volume of all layers is the Volume of the main sound card.", "" } },
    { "volume general|volume de toutes les couches|volume global|son trop fort|son trop faible", { "main volume global volume master volume too loud too quiet", "Volume of all layers: the Volume knob in the Sound tab. Final plugin volume: « Output » at the very bottom of the Effects tab. And each layer has its own Volume.", "" } },
    { "pan|panoramique|gauche droite", { "pan panning left right", "Each layer's « Pan » (in its card) places it left or right. To widen the whole sound: « Width » at the bottom of the Effects tab.", "" } },
    { "transpo|transposer|changer la hauteur|monter d'une octave|pitch", { "transpose pitch octave up change pitch", "« Transpose » shifts in semitones (+12 = one octave up). There's a Transpose per layer (in its card) and a global Transpose for all layers.", "" } },
    { "finesse|accorder finement|cents", { "fine tune fine cents", "« Fine »: fine tuning of the layer, in cents (hundredths of a semitone). Useful if a sample sounds a bit off.", "" } },
    { "accordage lie", { "linked tuning", "« Linked tuning »: on, changing one layer's transpose or fine tune shifts the other layers by the same amount.", "" } },
    { "retard d'une couche|retard", { "layer delay offset", "« Delay »: shifts the layer's start by a few ms. It makes a stack more natural (or thicker).", "" } },
    { "note racine|root note|note de base|le son est faux|le son n'est pas dans la bonne note", { "root note base note out of tune wrong note", "« Root note »: the note at which the sound plays as-is. Library sounds are in C5. Variant reads the note from the file name if it's there, otherwise it detects it. If it sounds off, set it by hand.", "" } },
    { "basses en c5|ma 808 change de note", { "basses in c5 my 808 changes note", "Basses keep their root note in the C5 octave, so your 808 plays the right pitch when you hit C5 in FL.", "" } },
    { "slide|glide|portamento|faire glisser les notes", { "slide glide portamento gliding notes", "« Slide / Glide » card in the Sound tab: Glide = Off, Legato (the note glides when two notes overlap, like in FL) or Always. Time = glide length. In Variant's piano roll, the Slide tool makes slide notes.", "" } },
    { "slide 808|faire glisser une 808", { "808 slide gliding 808", "For a gliding 808: Glide on « Legato », then in FL make two notes overlap: the second one glides from the first. Set the length with « Time ».", "" } },
    { "temps du slide|duree du slide", { "slide time glide time", "« Time » (Slide card): how long the note takes to glide to its pitch.", "" } },
    { "courbe du slide", { "slide curve glide curve", "« Curve » (Slide card): 0 = even glide, 100 = arrives fast then settles gently.", "" } },
    { "slide d'entree", { "slide in", "« Slide in »: each note starts this many semitones higher or lower, then glides to its real note.", "" } },
    { "mode legato des leads|leads en legato", { "lead legato mode legato leads", "Leads load in Legato automatically with a 30 ms slide, to play tied melodies.", "" } },
    { "cut|un accord coupe le precedent", { "cut chord cuts previous", "« Cut »: a new chord stops the previous one (notes played one by one don't cut each other). Handy to keep sounds from stepping on each other.", "" } },
    { "carte sample|reglages du sample", { "sample card sample settings", "« Sample » card (like FL's Sampler): Start, Length, Fade in/out, Trim silence, Reverse, Normalise, DC, Polarity, L ↔ R, and Loop points.", "" } },
    { "depart du sample|start|smp start", { "sample start start", "« Start »: where the sound begins (it cuts the start).", "" } },
    { "couper le blanc|enlever le silence au debut|blanc au debut|silence avant le son|silence au debut du son", { "trim silence remove silence start silence before sound", "« Trim silence » (Sample card) removes the silence before the sound starts: the Start lands just before the attack. Click again to go back to the start of the file.", "" } },
    { "longueur du sample", { "sample length", "« Length » (Sample card): how much of the sound is kept (it cuts the end).", "" } },
    { "fondu in|fade in", { "fade in", "« Fade in »: gentle rise at the start of the sound (removes attack clicks).", "" } },
    { "fondu out|fade out", { "fade out", "« Fade out »: gentle fall at the end of the sound.", "" } },
    { "inverser|reverse|son a l'envers", { "reverse backwards", "« Reverse » (Sample card): plays the sound backwards.", "" } },
    { "normaliser|normalize", { "normalise normalize", "« Normal. »: brings the sound to maximum level without clipping.", "" } },
    { "dc|decalage continu|offset dc", { "dc offset dc", "« DC »: removes the DC offset from the file (avoids clicks).", "" } },
    { "polarite|phase|deux couches s'annulent", { "polarity phase two layers cancel hollow", "« Polarity »: flips the polarity. Useful when two layers cancel each other and the sound gets hollow.", "" } },
    { "echanger gauche droite|g d", { "swap left right l r channels", "« L ↔ R »: swaps the left and right channels.", "" } },
    { "loop points|boucle du sample|tenir un son a l'infini", { "loop points sample loop hold sound forever sustain loop", "« Sample » card: turn on « Loop points »: the sound loops between the 2 green markers (drag them on the waveform) as long as the note is held. Perfect to make a one-shot last forever.", "" } },
    { "debut de boucle|fin de boucle", { "loop start loop end", "« Loop start » and « Loop end »: where the loop starts and ends (in ms in the sound). You can also drag the green markers.", "" } },
    { "fondu de boucle", { "loop fade crossfade", "« Fade » (loop): crossfade at the loop point. Higher = smoother loop, no click.", "" } },
    { "ping pong de la boucle|ping pong", { "loop ping pong ping pong", "« Ping-pong »: the loop goes back and forth instead of restarting at the beginning.", "" } },
    { "soundfont|sf2|preset de soundfont", { "soundfont sf2 soundfont preset", "Drop an .sf2 file on a layer: it loads right away, with one sample per key range and its loops (like FL's SoundFont Player). Change instrument with the menu in the layer card.", "" } },
    { "serum|presets d'autres plugins|lire un preset serum", { "serum presets other plugins presets load serum preset", "I can't read Serum, Zenology & co presets. But you can load the plugin itself inside Variant (« Plugins in Variant »), or export a note as .wav from FL and drop it on a layer.", "" } },
    { "boucle|loop|boucle d'arpege en wav", { "loop arpeggio loop wav loop", "« Loop » (on the layer): for arpeggios / loops in .wav. The loop stays locked to FL's tempo and position, and transposes without changing speed. In a chord, only the lowest note plays it.", "" } },
    { "bpm de la boucle|bpm boucle", { "loop bpm", "« Loop BPM »: the loop's original tempo. Auto = read from the file name (« 140bpm »), otherwise guessed from the length.", "" } },
    { "stretch|garder le tempo|suivre le bpm sans changer la hauteur", { "stretch keep tempo follow bpm without pitch change", "« Stretch »: for your one-shots and loops recorded at a BPM (140 by default, or the one in the name): the sound follows FL's tempo and every note keeps the same length (a high note isn't faster anymore).", "" } },
    { "arpegiateur des one shots|mode seq|one shot d'arpege", { "one shot arpeggiator seq mode arp one shot", "The layer's « Arpeggiator » button shows up for sounds named seq / arp (or in the Seq folder): the pattern follows FL's tempo, and when you hold a chord each step takes the next note of the chord.", "" } },
    { "clavier en gamme|jouer une gamme au clavier", { "scale keyboard play a scale on keyboard keys in key", "« Keyboard in scale » (Sound tab): every key of your computer keyboard plays only the notes of the chosen scale. Row A Z E R… = base octave, numbers = one octave up, rows below = one and two octaves down.", "" } },
    { "clavier d'ordinateur|jouer avec le clavier|jouer avec les touches", { "computer keyboard play with keyboard play with keys typing", "Computer keyboard: « Keyboard in scale » (Sound tab) to play your scale's notes, the keyboard section of Chords & MIDI for notes or chords, and in the Sampler the letters play the chops. Click inside the plugin first.", "" } },
    { "le clavier ne marche pas|les touches ne jouent rien", { "keyboard not working keys play nothing", "If the computer keyboard plays nothing: click inside the plugin first (otherwise FL gets the keys), and check that a keyboard mode is on (Keyboard in scale, or « Play with keyboard » in the Sampler).", "" } },
    { "changer d'octave au clavier", { "change octave keyboard octave up down", "With the computer keyboard, the up / down arrows change octave (when the bank doesn't have focus). In Keyboard in scale, the numbers already play one octave up.", "" } },
    { "clavier midi|controleur midi|jouer avec mon clavier midi", { "midi keyboard midi controller play with my midi keyboard", "Your MIDI keyboard works like with any FL instrument: select Variant's channel in the Channel rack and play.", "" } },
    { "plugins dans variant|charger un vst dans variant|ajouter un plugin", { "plugins in variant load vst in variant add plugin host", "« Plugins in Variant » card (Sound tab): « + Add a plugin… » loads a VST3 (Serum, Zenology, Diva…). It plays your notes, chords and arpeggio, and its sound goes through Variant's effects. You can also drop a .vst3 or a .vstpreset.", "" } },
    { "fenetre du plugin|ouvrir le plugin heberge", { "plugin window open hosted plugin", "« Window » opens the loaded plugin's interface to pick a preset and edit the sound.", "" } },
    { "reglages du plugin heberge|volume du plugin|retard du plugin", { "hosted plugin settings plugin volume plugin delay", "Each plugin in Variant has its own ON, Volume, Transpose, Fine (as pitch bend ±2 semitones), Pan and Delay. The cross removes it.", "" } },
    { "prise|enregistreur|enregistrer ce que je joue|recorder", { "take recorder record what i play recording", "« TAKE » card (Sound tab): click « ● Rec », recording starts with your first note (computer keyboard, MIDI or FL), up to 4 minutes. Then drag the MIDI or the WAV (effects included) into FL. « Clear » to start over.", "" } },
    { "effets|chaine d'effets|ajouter un effet", { "effects effect chain add effect", "Effects tab: drag a tile into the chain (6 slots max), or click it. Every effect has its presets and a Random button to find a setting fast.", "" } },
    { "effets auto|effets qui changent tout seuls|reverb automatique", { "auto effects effects change on their own automatic reverb", "Settings → « Auto effects »: each one-shot comes with its effects if it needs them. When you change the main sound, the chain is replaced with the effects meant for the new sound.", "" } },
    { "chaine au hasard|chaine aleatoire|chaine d'effets au hasard", { "random chain random effect chain", "« Random chain ▾ » (Effects tab) builds a coherent chain: lo-fi, spacious, dreamy, aggressive, glitch, ambient, halftime, vintage, french touch, liquid… or totally random.", "" } },
    { "hasard d'un effet|bouton hasard", { "effect random random button", "An effect's « Random » button picks random settings around its presets: it always stays musical.", "" } },
    { "presets d'effets|preset d'un effet", { "effect presets effect preset", "Every effect has its list of presets in its card (and on right-click on its tile). Every preset has real character.", "" } },
    { "bypass|contourner un effet|desactiver un effet", { "bypass disable effect", "An effect's small power button bypasses it without removing it. Right-click the effect: bypass, reset, move, remove.", "" } },
    { "monter un effet dans la chaine|ordre des effets|deplacer un effet", { "move effect up chain effect order reorder", "An effect's ↑ ↓ arrows move it up or down the chain. Order matters: distortion before the reverb doesn't sound like after.", "" } },
    { "retirer un effet|supprimer un effet", { "remove effect delete effect", "The card's ✕ removes the effect (Ctrl+Z if you regret it).", "" } },
    { "mix d'un effet|dry wet|dosage", { "effect mix dry wet blend", "« Mix »: blend between the original and the processed sound. 100 % = only the effect, 50 % = half and half.", "" } },
    { "sortie|volume final|volume de sortie", { "output final volume output volume", "« Output » (bottom of the Effects tab): the plugin's final volume, after all effects.", "" } },
    { "largeur stereo finale|largeur stereo|elargir le son", { "final stereo width stereo width widen sound", "« Width » at the bottom of the Effects tab: final stereo width. 0 % = mono, 100 % = normal, above = wider.", "" } },
    { "effets rapides|colonne d'effets", { "quick effects effect column", "The « Quick effects » column (Synth and Arpeggio pages): click an effect to add it to your chain, touch its drawing to set it, right-click for its presets or to remove it. It scrolls with the wheel.", "" } },
    { "effets suivent le tempo|delay synchro", { "effects follow tempo synced delay sync", "All moving effects (delay, tremolo, filter, chorus, phaser…) follow FL's BPM live and land on note values (1/4, 1/8…).", "" } },
    { "variant fx|effets dans le mixer|effet sur une piste du mixer", { "variant fx effects in mixer effect on mixer track", "The effects also exist as separate plugins for FL's mixer (Variant Reverb, Variant Delay…). Look for them in FL's effect list.", "" } },
    { "generateur d'accords|generer une progression|creer des accords", { "chord generator generate progression make chords", "Chords & MIDI tab: pick a mood, click « Generate a progression », listen with Space. Raise « Variety » for more surprising chords.", "" } },
    { "ambiance|style de progression", { "mood progression style genre", "The generator's « Mood »: Disco, Bossa nova, Jazz, Lo-fi, Trap, Pop, Epic / Cinematic, House, Ambient, Funk, Swagg (Pharrell-style / swag beats 90-100 BPM, acoustic chords with tension) and Baile (funk carioca, tamborzão). It picks the scales, chords and rhythm. Every click on Generate gives a truly different progression.", "" } },
    { "variete|accords plus originaux|accords surprenants", { "variety more original chords surprising chords", "« Variety »: higher = sus, add9, 6/9, quartal chords, inversions and passing chords. Less predictable progressions.", "" } },
    { "hors gamme|accords hors gamme|chromatique", { "out of key chords chromatic", "« Out of key »: 0 % = everything stays in the scale. Higher = secondary dominants, tritone subs, chromatic approaches…", "" } },
    { "couleur jazzy|accords jazz", { "jazzy colour jazz chords", "« Jazzy colour »: adds 9ths, 13ths and alterations (b9, #9, #11, b13). Raise it for a jazz / neo-soul sound.", "" } },
    { "richesse|accords simples ou riches", { "richness simple rich chords", "« Richness »: Simple (triads), Rich (7ths, 9ths) or Very rich (extensions everywhere).", "" } },
    { "registre|registre des accords", { "register chord register", "« Register »: where the chords sit (Auto, Low, Mid, High). For played chords: As played, Smooth voice leading, Low or High.", "" } },
    { "nombre de mesures|longueur de la progression", { "number of bars progression length", "The generator makes 4- or 8-bar progressions (menu next to the mood).", "" } },
    { "surprends moi", { "surprise me", "« Surprise me »: random mood, richness, colour and arpeggio, then a new progression.", "" } },
    { "j'aime|pas mon style|mes gouts|apprendre mes gouts", { "like not my style my taste learn my taste", "« Like » when you like a progression, « Not my style » otherwise. With « My taste » on, new progressions often start from the ones you liked. The more you rate, the more it sounds like you.", "" } },
    { "accords autour de mes notes|harmoniser une melodie", { "chords around my notes harmonize melody", "« Chords around my notes »: place your notes (a melody or a few long notes) then click: your notes stay, the plugin adds chords underneath (and the bass if it's on). « Another idea » suggests something else.", "" } },
    { "changer cet accord|remplacer un accord", { "change this chord replace chord", "« Change this chord » replaces only the selected chord, the rest stays the same.", "" } },
    { "ajouter un accord", { "add chord", "« + Add a chord » puts a chord in the first free space (or double-click an empty area of the piano roll).", "" } },
    { "couches de la progression|basse|accords basse arpege", { "progression parts bass chords bass arpeggio", "The generator can write three parts: Chords, Bass and Arpeggio. Tick the ones you want, each exports to MIDI separately.", "" } },
    { "piano roll|editer les notes|modifier les notes", { "piano roll edit notes", "The Chords & MIDI piano roll edits like FL's: click = note, drag = move, right edge = length, right-click = delete. Tools: Pencil, Brush, Eraser, Cut, Select, Slide, Chord. Wheel = up/down, Ctrl+wheel = zoom.", "" } },
    { "crayon", { "pencil", "« Pencil »: click = new note (at the last length used), drag = move, right edge = length.", "" } },
    { "pinceau|paint", { "brush paint", "« Brush »: drag to paint notes in a row, on the snap step.", "" } },
    { "gomme|effacer des notes", { "eraser delete notes", "« Eraser »: click or drag over notes to delete them (right-click erases with any tool).", "" } },
    { "outil couper|couper une note", { "cut tool split note", "« Cut » tool: click inside a note to split it in two.", "" } },
    { "selection|selectionner des notes", { "select selection select notes", "« Select »: draw a rectangle to select (Shift = add), then drag to move everything.", "" } },
    { "outil slide|notes slide|mode slide", { "slide tool slide notes slide mode", "« Slide » tool (like FL): a slide note (triangle) doesn't play, it glides the notes of the same colour already playing up to its pitch. « Slide mode »: every note you draw is a slide.", "" } },
    { "outil accord|tampon|stamp", { "chord tool stamp", "« Chord » tool (like FL's Stamp): click to place a chord from the scale, the clicked note is the root. Pick the type (Maj, min, 7, sus…) in the bar.", "" } },
    { "aimant|snap|grille du piano roll", { "snap grid piano roll grid", "« Snap » (like in FL): where notes land (1/16, 1/8…). Hold Alt to place without snap for one gesture.", "" } },
    { "quantifier|quantize", { "quantise quantize", "« Quantise » snaps the selected notes (or all of them) to the grid. Shortcut Ctrl+Q.", "" } },
    { "legato des notes|prolonger les notes", { "note legato extend notes", "« Legato » (piano roll) extends every note up to the next one. Shortcut Ctrl+L.", "" } },
    { "zoom du piano roll", { "piano roll zoom", "Piano roll zoom: + / − buttons or Ctrl + wheel. « All » shows the whole progression.", "" } },
    { "importer un midi|import mid", { "import midi import mid", "« Import .mid » loads a .mid file into the piano roll (you can also drop it on it).", "" } },
    { "revenir aux accords", { "back to chords", "« Back to chords » discards your note edits and goes back to the generated chords.", "" } },
    { "enregistrer dans le piano roll|enregistrer du midi", { "record into piano roll record midi", "« ● Record » (Chords & MIDI): records what you play (computer keyboard, MIDI keyboard, FL) and puts it in the piano roll.", "" } },
    { "exporter en midi|exporter vers fl|glisser le midi dans fl", { "export midi export to fl drag midi into fl", "Drag the MIDI chips (Chords, Bass, Arpeggio, All) straight into FL Studio, or click « Export all »: files go to Documents\\Variant MIDI.", "" } },
    { "midi sans chevauchement", { "midi without overlap", "« Generated MIDI without overlap »: in the exported MIDI, each chord stops when the next one starts.", "" } },
    { "play de fl|progression jouee par fl", { "fl play progression played by fl", "« FL Play »: on, when you hit Play in FL, the plugin plays ITS progression (chords, bass, arpeggio from this page), locked to the tempo, and ignores the notes in FL's piano roll. Off = it plays FL's notes.", "" } },
    { "espace pour ecouter|ecouter la progression", { "space to listen listen progression play", "Space plays the plugin's progression only in the Chords & MIDI tab. In the other tabs, Space is left to FL Studio.", "" } },
    { "tonalite|gamme|choisir la gamme|key", { "key scale choose scale", "Key and scale are set in Chords & MIDI (or in the Arpeggio). All chords created stay in the scale. They're synced across all your Variant instances.", "" } },
    { "gammes disponibles|liste des gammes|gamme exotique", { "available scales scale list exotic scale", "There are loads of scales: Major, Natural, Harmonic and Melodic minor, Dorian, Phrygian, Phrygian dominant, Lydian, Mixolydian, Locrian, Pentatonics, Blues, Japanese, Hirajoshi, Hungarian, Persian, Gypsy, Whole tone, Diminished, Bebop…", "" } },
    { "gamme synchronisee entre instances|plusieurs variant", { "scale synced between instances several variant", "When you change the key or scale in one Variant, every other Variant open in the project follows.", "" } },
    { "activer les accords|un doigt un accord|jouer des accords avec une note|accord fixe|mode accord", { "enable chords one finger chord play chords with one note fixed chord chord mode", "« Enable chords »: every note played triggers a full chord. « From the scale » mode = the chord follows the scale, « Fixed chord » = always the same type.", "" } },
    { "type d'accord|taille de l'accord", { "chord type chord size", "« Size »: Triad, 7th, 9th, 11th or 13th. In Fixed chord mode, « Type » picks the chord (major, minor, sus…).", "" } },
    { "voicing", { "voicing", "« Voicing »: how the chord notes are spread: Close, Open, Drop 2 or Bass + chord.", "" } },
    { "renversement|inversion d'accord", { "inversion chord inversion", "« Inversion »: which chord note is at the bottom. It changes the colour without changing the chord.", "" } },
    { "strum|accord guitare|egrener", { "strum guitar chord", "« Strum »: offsets each chord note, like strumming a guitar.", "" } },
    { "humanisation des accords", { "chord humanize humanise", "« Humanize » (chords): small timing and velocity imperfections for a less robotic feel.", "" } },
    { "mode accords du clavier|jouer des accords au clavier", { "keyboard chord mode play chords on keyboard", "Keyboard « Chords » mode (Chords & MIDI): pick Key and Scale, each key A Z E R T… plays a different chord from that scale (7ths, 9ths, sus, inversions).", "" } },
    { "metronome", { "metronome click", "The metronome is in the header: click = on/off, right-click = sound (Click, Wood, Bell, Hi-hat, 8-bit beep, Rimshot) and volume. It plays when you listen in Variant and while recording, not during FL playback.", "" } },
    { "arpege|arpegiateur|arp", { "arpeggio arpeggiator arp", "Arpeggio tab: turn it on, hold notes and it plays them one by one, in rhythm locked to FL. No idea? « Randomize all » finds a great-sounding pattern in one click.", "" } },
    { "activer l'arpege", { "enable arpeggio turn on arp", "« Enable arpeggio »: held notes are played one by one, in rhythm.", "" } },
    { "mode de l'arpege|sens de l'arpege", { "arpeggio mode arpeggio direction", "« Mode »: Up, Down, Up → Down, Up & down, Random, As played, Converge, Diverge, Chord (all notes), Pinky (top note) or Thumb (bottom note).", "" } },
    { "vitesse de l'arpege|vitesse arp", { "arpeggio rate arp speed", "« Rate » (arpeggio): the note value of each step, from 1/1 to 1/32, with triplets and dotted. 1/16 = the classic.", "" } },
    { "octaves de l'arpege", { "arpeggio octaves", "« Octaves »: how many octaves the arpeggio spans (1 to 4).", "" } },
    { "direction des octaves", { "octave direction", "« Octaves towards »: Upwards, Downwards, Up and down, or Auto (by register).", "" } },
    { "duree des notes de l'arpege|gate", { "arpeggio note length gate", "« Length » (arpeggio): length of each note. Small = staccato, over 100 % = tied notes.", "" } },
    { "swing|groove", { "swing groove", "« Swing » (arpeggio): shifts every other step for a more human groove.", "" } },
    { "repetition|repeter les notes", { "repeat repeat notes", "« Repeat »: plays each note several times in a row (1 to 4).", "" } },
    { "latch|maintien de l'arpege|l'arpege continue", { "latch hold arpeggio keeps going", "« Latch »: the arpeggio keeps going even when you release the keys.", "" } },
    { "contraindre a la gamme", { "snap to scale", "« Snap to scale »: keeps every arpeggio note in the chosen scale.", "" } },
    { "source de l'arpege|notes de l'arpege", { "arpeggio source arpeggio notes", "« Arpeggio notes »: Played notes (what you hold), Scale (it climbs the scale) or Slicer slices (it arpeggiates your chops).", "" } },
    { "velocite de l'arpege", { "arpeggio velocity", "« Velocity » (arpeggio): As played (keeps your playing strength) or Fixed.", "" } },
    { "pas|nombre de pas|longueur du motif|steps|nombre de steps", { "steps number of steps pattern length", "« Steps »: length of the rhythm pattern, from 1 to 16 steps.", "" } },
    { "motif|steps de l'arpege|les barres de l'arpege", { "pattern arpeggio steps arpeggio bars", "The 16 PATTERN steps are the rhythm: a bar's height = its strength, double-click = step played or rest. « Random pattern » suggests a new one.", "" } },
    { "motif au hasard", { "random pattern", "« Random pattern »: keeps your settings, only changes the rhythm and accents of the pattern.", "" } },
    { "tout au hasard", { "randomize all", "« Randomize all »: random mode, rate, octaves, length, swing and pattern, always locked to the beat.", "" } },
    { "humanisation de l'arpege", { "arpeggio humanize", "« Humanize » (arpeggio): natural accents, slightly imperfect timing and lengths.", "" } },
    { "liberte|improvisation", { "freedom improvisation improvise", "« Freedom »: the plugin improvises: octave jumps, passing notes, quick repeats, rests. 0 = it follows politely.", "" } },
    { "plus d'options|options de l'arpege", { "more options arpeggio options", "« More options ▾ » (Arpeggio) opens: Probability, Ratchet, Hits, Transpose, Offset, Accent, Ramp, and the switches « Restart on every note » and « Bass on the 1st step ».", "" } },
    { "probabilite", { "probability", "« Probability »: chance that each step plays. Below 100 %, the arpeggio skips notes at random and comes alive.", "" } },
    { "ratchet|roulement trap|hi hat roll", { "ratchet trap roll hi hat roll", "« Ratchet »: chance that a step is retriggered very fast several times (trap-style roll). « Hits » sets how many (2 to 4).", "" } },
    { "coups du ratchet", { "ratchet hits", "« Hits »: number of ratchet hits (2 to 4).", "" } },
    { "transpo de l'arpege", { "arpeggio transpose", "« Transpose » (Arpeggio): moves every arpeggio note up or down, in semitones.", "" } },
    { "decalage du motif|rotation", { "pattern offset rotation rotate", "« Offset »: starts the rhythm pattern further along. Same pattern, different groove.", "" } },
    { "accent des temps|accent", { "beat accent accent", "« Accent »: pushes the notes on the beats and softens the others.", "" } },
    { "rampe de velocite|rampe", { "velocity ramp ramp", "« Ramp »: velocity rises (right) or falls (left) over the length of the pattern.", "" } },
    { "repartir du debut a chaque note|restart", { "restart on every note restart", "« Restart on every note »: each new note restarts the arpeggio from its first note.", "" } },
    { "basse sur le 1er pas|basse sur le premier pas", { "bass on first step bass on 1st step", "« Bass on the 1st step »: adds the lowest note, one octave below, at the start of each pattern.", "" } },
    { "presets d'arpege", { "arpeggio presets", "« Arpeggio presets ▾ »: ready-to-play presets (a sound + arpeggio, chords, envelope and effects). « Save my preset… » keeps yours.", "" } },
    { "arpege seulement sur les seq|pourquoi l'arpege ne marche pas", { "arpeggio only on seq arpeggio not working why", "The automatic arpeggiator and stretch for one-shots only turn on for sounds named seq / arp (or in the Seq folder). For other sounds, turn on the Arpeggio tab.", "" } },
    { "sampler|slicer|decouper un sample|faire des chops", { "sampler slicer chop a sample make chops", "Sampler tab: drop a sample, it gets chopped into slices on its own. Each slice plays with a note (the lowest = slice 1), with the pads, or with the keyboard letters.", "" } },
    { "jouer les tranches|activer le slicer", { "play slices enable slicer", "« Play slices »: on, every note (keyboard, FL, arpeggio) plays the slices instead of the layers.", "" } },
    { "mode de decoupe|decoupe", { "slice mode slicing", "« Slice »: Transients (cuts on attacks), Grid (equal parts) or On tempo (cuts on the beats).", "" } },
    { "nombre de tranches|tranches", { "number of slices slices", "« Slices »: number of slices (maximum in Transients mode), from 2 to 64.", "" } },
    { "decoupe fine", { "fine slicing", "« Fine slicing »: tighter, more precise cuts (very short slices allowed, small attacks detected).", "" } },
    { "sensibilite", { "sensitivity", "« Sensitivity »: higher = also cuts on soft attacks. Lower it if you get too many slices.", "" } },
    { "1er chop|note du premier chop|chops dans le piano roll de fl", { "first chop note of first chop chops in fl piano roll", "« 1st chop »: the note that plays slice 1 in FL's piano roll (C0 = the lowest, or C3, C5), then one note per slice going up.", "" } },
    { "finesse du sampler", { "sampler fine tune", "« Fine » (Sampler): tunes the sample to the cent.", "" } },
    { "transpo du sampler", { "sampler transpose", "« Transpose » (Sampler): transposes all slices.", "" } },
    { "stretch du sampler", { "sampler stretch", "« Stretch » (Sampler): the slices follow FL's tempo without changing pitch (transpose changes the note, not the speed).", "" } },
    { "caler sur fl|repitch", { "sync to fl repitch", "« Sync to FL » speeds the sample up or down to follow FL's tempo (pitch changes too, like an old-school sampler).", "" } },
    { "couper au relachement", { "stop on release cut on release", "« Stop on release »: on, the slice stops when the note stops (tight rhythms). Off, it plays to the end.", "" } },
    { "une tranche a la fois|choke", { "one slice at a time choke", "« One slice at a time »: like an MPC, a new slice cuts the previous one. Cleaner when playing on the keyboard.", "" } },
    { "son des chops", { "chop sound", "The « Chop sound » row sets every slice: Attack, Release, Velocity, Colour and Equal volumes.", "" } },
    { "attaque des chops", { "chop attack", "« Attack » (chops): start of each chop. Short = punchy, long = soft entry that removes clicks.", "" } },
    { "relache des chops", { "chop release", "« Release » (chops): end of the chop when you let go. Short = dry, long = the sound fades out gently.", "" } },
    { "velocite des chops", { "chop velocity", "« Velocity » (chops): at 0 %, every hit has the same volume; towards 100 %, the harder you hit, the louder it is.", "" } },
    { "couleur des chops", { "chop colour", "« Colour » (chops): left = darker (lo-fi style), right = thinner (removes lows), centre = original sound.", "" } },
    { "volumes egalises", { "equal volumes", "« Equal volumes »: all chops at the same volume, the quiet ones go up and the loud ones go down (±12 dB max).", "" } },
    { "reglages d'un chop|clic droit sur un pad|volume d'un chop|pitch d'un chop|chop a l'envers|inverser un chop|pan d'un chop", { "chop settings right click pad chop volume chop pitch reverse chop chop pan", "Right-click a pad: settings for that chop only (Volume, Pitch, Pan, Reverse). The summary shows on the pad.", "" } },
    { "pads|pads du sampler", { "pads sampler pads", "The Sampler's 16 pads play the slices with the mouse. Right-click a pad = its settings. The Detach button opens them in a small window.", "" } },
    { "banques de pads|banque a b c d", { "pad banks bank a b c d", "Pad banks (like Serato): A = slices 1-16, B = 17-32, C = 33-48, D = 49-64.", "" } },
    { "jouer au clavier dans le sampler|chops au clavier", { "play with keyboard in sampler chops on keyboard", "« Play with keyboard » (Sampler): the letters play the slices: A Z E R T Y U I O P = 1 to 10, W X C V B N = 11 to 16, Q S D F G H J K L M = 17 to 26 (AZERTY layout). It turns on by itself on the Sampler page and takes priority over the arpeggio.", "" } },
    { "mes chops|choisir mes chops|chops a la main|faire mes propres chops|mes propres chops", { "my chops pick my chops manual chops make my own chops", "« My chops »: you choose. Drag on the waveform to draw each piece (movable edges, right-click = remove). Off = automatic slicing.", "" } },
    { "taper mes chops|tap", { "tap my chops tap", "« ✂ Tap my chops »: the sample scrolls and every time you press Space a cut is placed, snapped to the start of the hit. Esc or Stop to end.", "" } },
    { "deplacer un repere|repere de coupe", { "move a marker cut marker", "Drag a marker on the waveform: it snaps to transients (orange lines) or the grid, Alt = free. The ◀ ▶ buttons (or the arrows) nudge it by 1 ms (Shift = 10 ms). Double-click = add a marker.", "" } },
    { "zone a decouper|choisir une partie du sample", { "zone to chop choose part of sample", "Drag in the top strip of the waveform to choose the part to chop. Double-click in the strip (or « Zone: all ») = the whole sample.", "" } },
    { "zoom du sampler", { "sampler zoom", "« Zoom zone » zooms on the chosen part, « Zoom out » shows everything. The wheel on the waveform zooms too.", "" } },
    { "bpm du sample|tempo du sample|detecter le bpm|changer le bpm du sample", { "sample bpm sample tempo detect bpm change sample bpm", "The Sampler finds the sample's tempo and key. A BPM written in the file name (« 140bpm », or the Splice code « _130_ ») is taken as the right one. To change it: click the BPM on the info line, type the tempo, then Enter.", "" } },
    { "corriger le bpm|bpm faux|taper le bpm|le bpm est faux", { "fix bpm wrong bpm type bpm bpm is wrong", "Click the BPM on the Sampler's info line, type the right tempo, then Enter. Clear + Enter = automatic tempo. (name) = read from the name, (auto) = analysed, (you) = typed by hand.", "" } },
    { "tonalite du sample|appliquer au plugin", { "sample key apply to plugin", "The Sampler detects the sample's key. « Apply to the plugin » sets all of Variant's key and scale to it.", "" } },
    { "enregistrer mes chops|rec du sampler", { "record my chops sampler rec", "« ● Rec » (Sampler): play your chops (keyboard, pads, MIDI), click again to stop. « Listen » to hear it back, « Clear » to start over.", "" } },
    { "exporter les chops|glisser le motif dans fl", { "export chops drag pattern into fl", "After a Rec: drag the pattern as MIDI or audio (.wav) into FL, put it « Into a layer » of the Sound tab, or « To piano roll » in Chords & MIDI.", "" } },
    { "arpeger les tranches", { "arpeggiate slices", "« Arpeggiate slices »: turns on the slicer and the arpeggio over the slices with a random pattern. Hold a single note and it plays. « Another pattern » to change it.", "" } },
    { "decouper le son d'une couche", { "chop a layer sound slice layer", "The layer menu + « Slice » (Sampler) chops the sound loaded in that layer of the Sound tab.", "" } },
    { "tranches trop courtes|trop de tranches", { "slices too short too many slices", "The slicer doesn't make slices shorter than 0.2 s (except with Fine slicing). For fewer slices, lower « Slices » or « Sensitivity ».", "" } },
    { "synthe|synthetiseur|table d'ondes|wavetable", { "synth synthesizer wavetable", "Synth tab: a wavetable synth (like Serum): 2 oscillators, sub, noise, filter, 3 envelopes, 4 LFOs, a modulation matrix and 4 macros. It plays the same notes as the layers and goes through your effects.", "" } },
    { "allumer le synthe|synthe allume", { "turn on synth synth on", "« Synth: on »: the synth plays the same notes as the layers (keyboard, chords, arpeggio, FL) and goes through your effects.", "" } },
    { "synthe seul|solo du synthe", { "synth solo", "« Solo »: on the Synth page, your keyboard plays the synth ALONE so you can tweak the sound in peace. Off = you hear everything together.", "" } },
    { "volume du synthe|mix du synthe", { "synth volume synth mix", "The synth's Mix sets its volume next to the sample layers.", "" } },
    { "oscillateur|osc a|osc b", { "oscillator osc a osc b", "OSC A and OSC B: each reads a wavetable. Settings: Position, Warp, Octave, Semitone, Fine, Unison, Detune, Blend, Width, Phase, Random phase, Volume, Pan.", "" } },
    { "choisir une table d'ondes|tables de serum|deposer un wav dans le synthe|wav dans le synthe", { "choose wavetable serum tables drop wav in synth", "An oscillator's table button picks a wavetable: Serum's on your PC, the basic tables, or a file. You can also drop a .wav on the drawing.", "" } },
    { "position|position dans la table", { "position wavetable position", "« Position »: where the wavetable is read, the tone changes. You can also drag directly on the drawing.", "" } },
    { "warp|bend", { "warp bend", "« Warp »: bends the waveform (brighter or rounder).", "" } },
    { "octave de l'oscillateur|demi ton|fin de l'oscillateur", { "oscillator octave semitone oscillator fine", "Octave, Semitone and Fine (cents) tune each oscillator.", "" } },
    { "unisson|unison", { "unison", "« Unison »: number of stacked voices per note (wider and bigger sound).", "" } },
    { "detune", { "detune", "« Detune »: pitch spread between unison voices. Higher = wider and more chorus.", "" } },
    { "blend", { "blend", "« Blend »: volume of the outer unison voices compared to the centre voice.", "" } },
    { "largeur de l'unisson", { "unison width", "« Width » (oscillator): stereo spread of the unison voices.", "" } },
    { "phase|phase aleatoire", { "phase random phase", "« Phase »: the wave's start point. « Random phase »: random start on every note (more alive).", "" } },
    { "sub|sub oscillateur", { "sub sub oscillator", "SUB adds a simple low oscillator under the sound, for weight.", "" } },
    { "bruit du synthe|noise", { "synth noise noise", "NOISE (synth): adds noise to the sound (breath, attack).", "" } },
    { "filtre du synthe|cutoff|frequence de coupure|types de filtre du synthe|filtre peigne", { "synth filter cutoff cutoff frequency synth filter types comb filter", "FILTER (synth): Low-pass 12/24, High-pass 12/24, Band-pass, Notch or Comb. « Cutoff » = cutoff frequency, « Resonance » = peak at the cutoff.", "" } },
    { "resonance", { "resonance", "« Resonance »: boosts the frequencies around the filter cutoff. High = whistling / acid sound.", "" } },
    { "drive du synthe", { "synth drive", "« Drive » (synth): saturation before the filter.", "" } },
    { "mix du filtre", { "filter mix", "« Mix » (synth filter): blend of filtered / direct sound.", "" } },
    { "suivi clavier|key tracking", { "key tracking keytrack", "« Key tracking »: the filter opens for high notes.", "" } },
    { "enveloppes du synthe|env 1|env 2", { "synth envelopes env 1 env 2", "The synth has 3 envelopes: ENV 1 = volume, ENV 2 and 3 = route them anywhere in the matrix (filter, position…). Each has Attack, Decay, Sustain, Release.", "" } },
    { "lfo|vitesse du lfo|forme du lfo", { "lfo lfo rate lfo shape", "4 LFOs: Sine, Triangle, Saws, Square, Random (S&H) or Smooth random shapes. « Rate », « Sync » (follows FL's tempo: 1/4, 1/8…), « Per note » (restarts on every note). Route them in the matrix.", "" } },
    { "matrice de modulation|moduler un parametre", { "modulation matrix modulate parameter", "The matrix (10 rows): pick a source (Env, LFO, velocity, note, mod wheel, macro, random) and a destination, then the amount (middle = nothing, left = inverted). Or right-click a synth knob → modulate.", "" } },
    { "macros", { "macros", "MACROS: 4 knobs to route to several settings in the matrix. One move that changes lots of things.", "" } },
    { "poly mono legato|polyphonie|mode mono|mono|mode poly", { "poly mono legato polyphony mono mode poly mode", "Poly = chords. Mono = one note at a time. Legato = one note at a time without retriggering the envelope (basses, leads). « Polyphony » = number of notes at once.", "" } },
    { "glide du synthe", { "synth glide", "« Glide » (synth): notes slide from one to the next.", "" } },
    { "pitch bend", { "pitch bend", "« Pitch bend » (synth): the range of your MIDI keyboard's pitch wheel.", "" } },
    { "velocite du synthe", { "synth velocity", "« Velocity » (synth): higher = notes played hard are louder.", "" } },
    { "presets du synthe|sauver un son de synthe", { "synth presets save synth sound", "« Save » stores your synth sound in your bank (Synth presets). « Random » rolls a random sound, « Init » starts over from a simple saw, « … » opens the folder.", "" } },
    { "reglages|roue dentee|parametres du plugin", { "settings gear plugin settings", "The gear (top right): theme, language, size, visual effects, auto level, startup sound, Quality+, auto effects, Kick, guided tour, shortcuts.", "" } },
    { "theme|couleurs|changer le look", { "theme colours change the look skin", "Change the theme with the list at the top right (or Settings). The Y2K themes add a retro look.", "" } },
    { "themes palestine lfi bresil|drapeaux", { "palestine lfi brazil themes flags", "The Palestine, La France insoumise and Brazil themes are in the theme list, with their emblem next to the title.", "" } },
    { "langue|anglais|english|changer la langue", { "language english change language", "Change the language with the gear → Language.", "" } },
    { "taille de l'interface|agrandir le plugin|redimensionner", { "interface size enlarge plugin resize bigger smaller", "Drag the window corner: the plugin keeps its proportions and never goes past your screen. Or gear → Interface size.", "" } },
    { "effets visuels|particules|animations|l'interface vibre", { "visual effects particles animations interface shakes", "Gear → Visual effects: Off, Subtle or Normal. Off = no more particles or shaking on the bass.", "" } },
    { "niveau auto", { "auto level", "Settings → « Auto level »: turns down sounds that are too loud on load.", "" } },
    { "qualite plus|polish", { "quality plus polish", "Settings → « Quality+ »: one-shots get polished (clean lows, air, dynamics).", "" } },
    { "raccourcis clavier|raccourcis|f1", { "keyboard shortcuts shortcuts f1 hotkeys", "F1 (or gear → Keyboard shortcuts) shows all the shortcuts: Ctrl+Z / Ctrl+Y, Ctrl+Q, Ctrl+L, Space…", "" } },
    { "annuler|undo|ctrl z|retour en arriere", { "undo ctrl z go back", "Ctrl+Z undoes (sounds loaded or removed, settings, notes, effects, chops), Ctrl+Y redoes. Right-clicking a layer, an effect or the slicer also offers « Undo ».", "" } },
    { "obliterate|bombe|tout remettre a zero|reset", { "obliterate bomb reset everything reset", "The bomb at the top resets everything, like a brand-new plugin. Click once to arm it, a second time to blow it up. No going back.", "" } },
    { "detacher|fenetre a part|detacher une page", { "detach separate window detach a page pop out", "The Detach button (⧉) opens the page (or a card, the pads, the generator, the export) in its own window, to place anywhere next to FL. « Dock it back here » puts it back.", "" } },
    { "molette|scroller|faire defiler", { "mouse wheel scroll scrolling", "The wheel scrolls the pages everywhere, except on knobs (there it turns them).", "" } },
    { "reinitialiser un potard|valeur par defaut|taper une valeur", { "reset knob default value type a value", "Double-click a knob = its default value. Right-click = Reset or Type a value.", "" } },
    { "automation|automatiser un potard", { "automation automate knob", "Every knob can be automated in FL: turn it, then in FL « Tools > Last tweaked > Create automation clip ».", "" } },
    { "sauvegarder|sauver mon projet|mes reglages sont perdus", { "save save my project my settings are lost", "Everything you set in Variant is saved with your FL project (.flp). To reuse a sound elsewhere, save a preset.", "" } },
    { "presets|sauver un preset|mes presets", { "presets save preset my presets", "Save your sound (layers + settings + effects) as a preset: it's stored in Sound bank > My presets. The bank button shows the name of the loaded preset or sound.", "" } },
    { "hasard partout|aleatoire|random", { "random everywhere randomize", "There's randomness everywhere: « Random » on every effect, « Random chain », « Randomize all » in the Arpeggio, « Surprise me » in the generator, « Random » in the Synth.", "" } },
    { "kick|qui es tu|t'es qui|c'est qui kick", { "kick who are you who is kick", "I'm Kick: I live at the bottom right of your plugin, I skate and I explain everything. Ask me anything about Variant, even offline.", "" } },
    { "skin de kick|changer la tenue de kick|changer de personnage", { "kick skin change kick outfit change character", "Right-click me (or gear → Kick's skin) to change character: Mélenchon, Tony Soprano, orangutan, Steve, Wiz Khalifa, Caballero, JeanJass, Nougaro, Sassy the Sasquatch, the Aussie, the cube…", "" } },
    { "desactiver kick|cacher kick|enlever kick", { "disable kick hide kick remove kick", "Right-click me → « Disable Kick ». To bring me back: gear → « Kick the guide », or pick a skin directly in « Kick's skin ».", "" } },
    { "remettre kick|kick a disparu|faire revenir kick", { "bring kick back kick disappeared", "Gear (top right) → tick « Kick the guide (little skater) », or pick a skin in « Kick's skin »: I'm back right away.", "" } },
    { "kick sur le bureau|kick danse", { "kick on desktop kick dances", "Right-click me → « Take Kick out on the desktop »: I dance to the tempo next to FL. Mouse wheel on me to change my size.", "" } },
    { "replique|citation|phrase culte", { "quote line catchphrase", "Right-click me → « A quote! »: every character has its lines. I also drop them now and then on my own.", "" } },
    { "instagram|mon @|pseudo instagram|entrer mon @", { "instagram my @ instagram handle enter my @ licence license", "On first launch, Variant asks for your @Instagram: that's your licence. An @ only works on one PC.", "" } },
    { "@ deja utilise|changer de pc|liberer le @", { "@ already used change pc new computer free the @", "An Instagram @ only works on one PC. If you change computer, ask the creator (@prodbysotam) to free your @.", "" } },
    { "plugin bloque|plugin desactive|plus de son bloque", { "plugin blocked plugin disabled locked", "If Variant says it's disabled, the licence for this @ was cut by the creator. Contact @prodbysotam.", "" } },
    { "createur|qui a fait variant|prodbysotam", { "creator who made variant prodbysotam author", "Variant was made by @prodbysotam. If you like it, go tell him on Instagram.", "" } },
    { "statistiques|stats", { "statistics stats", "Variant's statistics are for the creator only (@prodbysotam), they're not in your version.", "" } },
    { "installer|fl ne trouve pas variant|scanner les plugins", { "install fl can't find variant scan plugins plugin not showing", "In FL: Options → Manage plugins → Find plugins. Variant is in the system VST3 folder (Program Files\\Common Files\\VST3). Then add it from the Channel rack.", "" } },
    { "mac|ableton|logic|autres daw|compatibilite", { "mac ableton logic other daw compatibility compatible", "Variant is on PC (VST3) and on Mac (VST3 and AU): it works in FL Studio, Ableton, Cubase, Studio One, Reaper, Bitwig, and Logic on Mac. Not in Pro Tools (it needs AAX).", "" } },
    { "mise a jour|nouvelle version|version", { "update new version version", "New versions of Variant are sent by the creator. Close FL before installing, then restart it.", "" } },
    { "cpu|ca rame|trop lourd|latence", { "cpu lagging too heavy latency slow", "If it lags: lower the number of active layers, remove heavy effects (Reverb, Grain, Pad, Prisme on High quality), and raise the audio buffer size in FL (Options → Audio).", "" } },
    { "pas de son|j'entends rien|silence", { "no sound i hear nothing silence", "No sound? Check that a layer has a sound and is on, that the volume isn't all the way down, that you entered your @Instagram at launch, and that the slicer isn't on without a sample (« Play slices »).", "" } },
    { "fl ne joue rien|le piano roll de fl ne joue pas", { "fl plays nothing fl piano roll doesn't play", "If FL plays nothing: check that the pattern uses Variant's channel in the Channel rack, and that a layer has a sound. In FL's piano roll, C5 = the original note.", "" } },
    { "bug|crash|plantage|ca plante", { "bug crash crashing freeze error report bug", "If Variant crashes or bugs: save your project, restart FL, then gear → « Report a bug » and explain what you were doing just before. The creator gets it right away. Ctrl+Z can also save a mistake.", "" } },
    { "faire une 808|basse 808|808 qui glisse", { "make an 808 808 bass gliding 808", "For an 808: load an 808 from the bank (basses category), « Play to the end » if it has to sustain, Glide on Legato for slides, and light Saturation so it's heard on small speakers.", "" } },
    { "son plus gros|son plus large|epaissir", { "bigger sound wider sound thicken fat", "For a bigger sound: stack 2-3 layers (Auto button), add Chorus or Stereo, a bit of Compressor, and raise the Width at the bottom of the Effects tab. Keep the lows mono.", "" } },
    { "faire un son lofi|son vintage|rendre le son lofi", { "make lofi sound vintage sound lofi", "For lo-fi: the Lo-fi effect (Wow, Flutter, Bits), Noise on Vinyl, a low-pass Filter, or a lo-fi « Random chain ». In the Sampler, push the chop Colour to the left.", "" } },
    { "faire un pad|son d'ambiance|nappe", { "make a pad ambient sound pad", "For a pad: the Pad effect turns any one-shot into a pad (soft swell, freeze, choir, big reverb). Add a long Reverb and a slow Attack.", "" } },
    { "sidechain|pompe|effet pompe", { "sidechain pumping pump effect", "For a pumping effect: « Shape », volume slot « Sidechain » or « Soft pump », locked to FL's tempo.", "" } },
    { "halftime|ralentir le groove|demi vitesse", { "halftime slow groove half speed", "« Ralenti » effect: replays the sound at half speed (or 2/3, 3/4, 1/4) over a loop locked to FL. « Keep pitch » mode so it doesn't drop in pitch.", "" } },
    { "son trop brillant|enlever les aigus|son agressif", { "too bright remove highs harsh sound", "Too bright: low-pass Filter, the EQ (high shelf down), or the Tone of Saturation / Delay to the left.", "" } },
    { "enlever les basses|trop de basses|son boueux", { "remove bass too much bass muddy", "Too much low end: EQ with a low cut, or « Mono lows » / Low cut on the Saturation. In the Sampler, chop Colour to the right.", "" } },
    { "plus de basses|plus de graves", { "more bass more low end", "More low end: EQ (low shelf up), the synth's SUB, or an extra bass layer (Auto → body / low).", "" } },
    { "ca sature|mon son sature|ca clip|ca gresille|distorsion pas voulue|le son grésille", { "clipping distortion my sound clips crackling unwanted distortion", "If it clips: lower the layers' Volume or the Output, turn on « Auto level » in the settings, and check the effects' Drive.", "" } },
    { "accords tristes|progression triste|ambiance sombre", { "sad chords sad progression dark mood", "For sad: Natural minor or Harmonic minor scale, « Trap » or « Epic / Cinematic » mood in the generator, and a bit of Variety.", "" } },
    { "accords joyeux|progression joyeuse", { "happy chords happy progression", "For happy: Major or Lydian scale, « Pop », « Disco » or « Swagg » mood.", "" } },
    { "quelle gamme pour la drill|gamme pour la trap", { "drill scale trap scale which scale", "Trap / drill: Natural minor, Harmonic minor or Phrygian work great (« Trap » or « Baile » mood).", "" } },
    { "c'est quoi une gamme", { "what is a scale", "A scale is the set of notes that sound good together in a track (e.g. C minor). Variant keeps your chords and arpeggio in the chosen scale.", "" } },
    { "c'est quoi un one shot", { "what is a one shot", "A one-shot is a single sound (a kick, a piano note, an 808) that Variant replays at the pitch of each note.", "" } },
    { "c'est quoi un chop", { "what is a chop", "A chop is a cut-out piece of a sample. The Sampler chops on its own, and you replay the chops in any order you want.", "" } },
    { "c'est quoi un lfo", { "what is an lfo", "An LFO is a slow wave that moves a setting on its own (vibrato, wobble, a breathing filter). In the Synth, route it in the matrix.", "" } },
    { "c'est quoi la velocite", { "what is velocity", "Velocity is how hard a note is played (0 to 127). Variant uses it for volume and tone.", "" } },
    { "salut|bonjour|yo|wesh|coucou|hello", { "hi hello hey yo sup", "Yo! Ask your question, I'm ready. Like « how do I export MIDI » or « what's the Ratchet for ».", "" } },
    { "ca va|comment tu vas|cava", { "how are you how's it going", "Always, I'm skating in your plugin. And you, making beats?", "" } },
    { "merci|thanks|cool|parfait|top", { "thanks thank you cool perfect great", "My pleasure. You owe me a kickflip.", "" } },
    { "blague|fais moi rire|raconte une blague", { "joke make me laugh tell me a joke", "Why did the drummer put his plugin in the fridge? To get cooler sounds. … Ok, back to skating.", "" } },
    { "t'es nul|tu sers a rien|t'es con", { "you suck you're useless stupid", "Ouch. Rephrase your question with other words, I'm doing my best. Like the name of the knob or the page.", "" } },
    { "tu es une ia|es tu une intelligence artificielle|chatgpt", { "are you an ai artificial intelligence chatgpt bot", "I'm a little offline guide: I know all of Variant by heart, no connection needed. For the rest of life, I'm just a skater.", "" } },
    { "au revoir|bye|a plus|ciao", { "goodbye bye see you later ciao", "See ya! Click me if you need anything.", "" } },
    { "aide|help|j'ai besoin d'aide|je suis perdu", { "help i need help i'm lost", "Don't panic. Tell me a button's name or what you want to do (« chop a sample », « export MIDI », « make an 808 »), or type « tour » for the full tour.", "" } },
    { "astuce|un conseil|tips", { "tip advice tips", "Tip: hover over any setting and wait a second, I'll explain what it does. And the « A tip » button gets more out of me.", "" } },
    { "fx:Saturation", { "Saturation", "saturation saturator distortion drive warmth tube tape fuzz crunch", "Saturation adds analog warmth (Tube, Transformer, Console, Tape or Fuzz), oversampled to stay clean. Perfect to make an 808 or a piano cut through." } },
    { "fx:Filtre", { "Filter", "filter low pass high pass band pass notch ladder resonance sweep moving filter wah", "The Filter cuts frequencies (Low-pass, High-pass, Band-pass, Notch, Ladder 24 dB) and can move on its own in rhythm with « Movement » and « Speed »." } },
    { "fx:Compressor", { "Compressor", "compressor compression ott multiband upward downward dense bright", "Compressor compresses upward and downward on 3 bands: a dense, bright sound in one move. Raise « Depth » and you're done." } },
    { "fx:Égaliseur", { "EQ", "eq equalizer equaliser parametric bands bell shelf cut slope curve points", "The EQ is parametric like FL's: drag the points on the curve (frequency and gain), wheel = width, right-click = type (bell, shelf, cut, notch) and slope (12 to 48 dB/oct), double-click = turn the band off." } },
    { "fx:Chorus", { "Chorus", "chorus dimension thick double wide voices", "The Chorus thickens the sound Dimension-style (modes I, II, I + II, Ensemble): like several instruments playing together." } },
    { "fx:Flanger", { "Flanger", "flanger jet plane sweep through zero metallic", "The Flanger makes the jet effect (metallic sweep), with a through-zero mode for a deeper sound." } },
    { "fx:Phaser", { "Phaser", "phaser swirl analog stages", "The Phaser makes the sound swirl (2 to 12 stages), like an analog pedal." } },
    { "fx:Trémolo", { "Tremolo", "tremolo auto pan autopan pulse volume rhythm", "The Tremolo pulses the volume in rhythm, or moves the sound left / right (Auto-pan)." } },
    { "fx:Lo-fi", { "Lo-fi", "lofi lo fi bitcrusher crusher cassette tape bits wow flutter vintage worn", "Lo-fi damages the sound on purpose: reduced bits and sample rate (digital grit), Wow and Flutter (worn tape)." } },
    { "fx:Grain", { "Grain", "grain granular grains clouds echoes texture", "Grain cuts the sound into grains and makes clouds and granular echoes out of them. Great for textures." } },
    { "fx:Givre", { "Givre", "givre frost crystal reverse echoes pitched echoes octave shimmer", "Givre makes reversed and pitched echoes (octaves, fifths): a sparkling sound." } },
    { "fx:Delay", { "Delay", "delay echo tape echo repeat ping pong tempo ducking", "The Delay is a tape echo locked to FL's tempo, with ping-pong, tape wear, diffusion and ducking." } },
    { "fx:Réverb", { "Reverb", "reverb space room hall tail shimmer", "The Reverb puts the sound in a deep, living space, with a Shimmer that adds bright octaves and times you can lock to the tempo." } },
    { "fx:Stéréo", { "Stereo", "stereo width widener imager haas mono balance placement", "Stereo sets width and placement: Width, Haas effect, Mono lows and Balance." } },
    { "fx:Ralenti", { "Ralenti", "ralenti halftime half time half speed slow down groove", "Ralenti slows the groove without slowing the project: it replays the sound at half speed (or 2/3, 3/4, 1/4) over a loop locked to FL." } },
    { "fx:Shape", { "Shape", "shape gross beat grossbeat shaper sidechain time volume halftime reverse stutter tape stop", "Shape replays the past (halftime, reverse, stutter, tape stop…) and sculpts the volume (sidechain, gate…). Pick a time slot and a volume slot, or draw your own in the editor (TIME / VOLUME tab)." } },
    { "fx:Glitch", { "Glitch", "glitch stutter grid tracks steps repeat reverse tape stop pitch crush gate", "Glitch: 6 effect tracks (Repeat, Reverse, Tape stop, Pitch, Crush, Gate) over 16 steps. Click or drag on the cells to draw your pattern. Clear, Random and Offbeat buttons under the grid." } },
    { "fx:Prisme", { "Prisme", "prisme prism chroma harmonizer retune scale tune frequencies resonance", "Prisme retunes any sound to your scale: out-of-key frequencies go to the nearest right note. In « Played notes (MIDI) », it follows the chords you play." } },
    { "fx:Nappe", { "Pad", "pad nappe ambient freeze swell choir space", "Pad turns any one-shot into a pad: soft swell, freeze, choir and big reverb, 6 styles." } },
    { "fx:Wobble", { "Wobble", "wobble liquid curve draw flanger chorus phaser movement", "Wobble: draw a curve (1 to 4 bars, locked to FL) that moves a flanger, a chorus or a phaser. Click = point, drag = move, right-click = delete." } },
    { "fx:Bruit", { "Noise", "noise hiss white pink vinyl tape radio crackle", "Noise adds hiss (white, pink, vinyl, tape, radio) that follows the sound or pulses in rhythm, with vinyl crackle." } },
    { "knob:Saturation>Modèle", { "Model", "model type", "the saturation type: Tube (soft), Transformer (fat in the lows), Console (subtle), Tape (compressed, vintage) or Fuzz (dirty)." } },
    { "knob:Saturation>Drive", { "Drive", "drive amount", "the amount of saturation: higher = warmer, then dirtier." } },
    { "knob:Saturation>Ton", { "Tone", "tone brightness highs", "the colour after saturation: left darker, right brighter." } },
    { "knob:Saturation>Coupe-bas", { "Low cut", "low cut", "removes lows before the saturation so it doesn't smear into the bass." } },
    { "knob:Saturation>Dureté", { "Hardness", "hardness aggressive", "the hardness of the clipping: low = round, high = aggressive." } },
    { "knob:Saturation>Sortie", { "Output", "output volume", "the output volume of the saturation (to compensate for the Drive)." } },
    { "knob:Filtre>Type", { "Type", "filter type", "the filter type: Low-pass (keeps the lows), High-pass (keeps the highs), Band-pass, Notch or Ladder 24 dB (fat, Moog-style)." } },
    { "knob:Filtre>Fréquence", { "Frequency", "frequency cutoff", "the cutoff frequency: where the filter starts cutting." } },
    { "knob:Filtre>Résonance", { "Resonance", "resonance peak", "boosts the area around the cutoff: high = whistling sound, acid 303-style." } },
    { "knob:Filtre>Drive", { "Drive", "drive", "saturates the sound inside the filter, for more grit." } },
    { "knob:Filtre>Mouvement", { "Movement", "movement modulation", "how much the frequency moves on its own in rhythm (0 = fixed)." } },
    { "knob:Filtre>Vitesse", { "Speed", "speed rate", "the speed of the movement, locked to FL's tempo." } },
    { "knob:Compressor>Profondeur", { "Depth", "depth amount", "the amount of Compressor: it's the main knob." } },
    { "knob:Compressor>Vitesse", { "Speed", "speed time attack release", "the speed of the compression: Fast (more aggressive), Normal or Slow (softer)." } },
    { "knob:Compressor>Écrase (haut)", { "Squash (high)", "downward squash", "tames loud sounds (downward compression)." } },
    { "knob:Compressor>Remonte (bas)", { "Lift (low)", "upward lift", "brings out quiet details (upward compression)." } },
    { "knob:Compressor>Graves", { "Low", "low band lows", "the level of the low band (-12 to +12 dB)." } },
    { "knob:Compressor>Médiums", { "Mids", "mids mid band", "the level of the mid band." } },
    { "knob:Compressor>Aigus", { "Highs", "highs high band", "the level of the high band." } },
    { "knob:Compressor>Sortie", { "Output", "output volume", "the output volume of Compressor." } },
    { "knob:Égaliseur>Sortie", { "Output", "output volume", "the volume after the EQ." } },
    { "knob:Chorus>Mode", { "Mode", "mode", "the character: I, II, I + II (Dimension-style) or Ensemble (richer)." } },
    { "knob:Chorus>Vitesse", { "Speed", "speed rate", "the speed of the wobble." } },
    { "knob:Chorus>Profondeur", { "Depth", "depth", "the amount of wobble: higher = more movement." } },
